<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser build of the engine. Its only job is to expose MucEngine to JavaScript;
       the page loads it in a Web Worker so compiling and rendering never block the editor. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MucPlaygroundWeb</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Shift-JIS lives in the code-pages tables, which invariant mode would otherwise trim away. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <!-- Ahead-of-time compiled: about 7x faster than the interpreter, so songs that drive
         OPNA and all the MSX chips at once still render well ahead of playback. -->
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/MucEngine.csproj" />
    <TrimmerRootAssembly Include="System.Text.Encoding.CodePages" />
    <!-- AOT compiles every method, including ones that name musicDriverInterface types, so
         the assembly must survive trimming and reach the AOT compiler (see below). -->
    <TrimmerRootAssembly Include="musicDriverInterface" />
  </ItemGroup>
  <!-- musicDriverInterface is a plain file reference (no project), which the SDK leaves out
       of the assemblies it hands to the AOT compiler; add the trimmed copy by hand. -->
  <Target Name="BundleMusicDriverInterface" AfterTargets="_GatherWasmFilesToPublish">
    <ItemGroup>
      <WasmAssembliesToBundle Include="$(ProjectDir)$(IntermediateOutputPath)linked/musicDriverInterface.dll" />
    </ItemGroup>
  </Target>
</Project>
