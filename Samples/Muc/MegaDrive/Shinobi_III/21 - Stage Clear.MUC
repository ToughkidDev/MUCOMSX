#mucom88 1.7
#title BGM $98
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#pcm SHINOB98.BIN
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{o8g+%11 r%7 E255,255,0,255,0,255}
#*2{P1 E255,255,0,255,3,255}

A C96 l16 vm2 @105 v111 p3 D0 MF0 o3g g r8 g f g D1 g+8. D0 M24,1,2,9 a+%61

B C96 l16 vm2 @106 v109 p3 D0 MF0 o6f f r8 f8. d8. M22,2,5,3 d+%61

C C96 l16 vm2 @106 v109 p2 D0 MF0 o6d d r8 d8. c8. M22,2,8,3 c%61

D C96 l16 @0 r%60 *2 v12 D-24 M3,1,1035,2 *1 v10 g+%11 r%7 E255,255,0,255,4,255
D v9 g+%11 r12 v8 *1 v6 g+%11 r%7 v5 M2,1,1035,2 g+16. r16.

E C96 l16 @0 r%63 *2 v11 D-24 M3,1,1035,2 o8g+%11 r%7 v10 *1 v8 M4,1,1035,2 g+8
E r%7 E255,255,0,255,5,255 v7 M3,1,1035,2 g+%11 r%7 v6 *1 v0 MF0 g+96 r%17

G C96 l16 t192 r%114 t191 r%58

H C96 l16 vm2 @106 v109 p1 D0 MF0 o6c c r8 c8. <a+8. D1 M22,2,5,3 >g+%61

I C96 l16 vm2 @106 v109 p3 D0 MF0 o5g g r8 g8. a+8. M22,2,5,3 f%61

K C96 l16 p3 @2 v62 D-801 o1a+ D869 a+8. @1 D5037 b8. b8. @2 D484 a+%30 r8.
