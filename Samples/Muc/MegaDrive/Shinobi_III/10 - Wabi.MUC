#mucom88 1.7
#title BGM $8C
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{P1 E255,255,0,255,0,255 v0 D1879 MF0 o8b96}
#*2{M1,1,-3,2 o7c M1,1,-2,2 d+}
#*3{D0 M1,1,-2,2 o6f a+ *2 M2,1,-2,2 f M1,1,-2,2}
#*4{*1 r48 E255,255,0,255,2,255 v11}
#*5{r16 E255,255,0,255,0,255 v6 MF0}

A C96 l8 vm2 r96 @64 v111 p3 *3 d+ *2 f16 M2,1,-1,3 f4

B C96 l8 vm2 r%7 @64 v109 p1 *3 d+ *2 M2,1,-1,255 f32& MF0 f96& M0,1,2,255 f48
B M2,1,-2,2 f4

C C96 l8 vm2 r96 @45 v104 p2 D0 M3,2,1,3 o4f1& f1

D C96 l8 @0 *4 D3 M4,1,-8,4 o4f%42 *5 f96 r%47 v0 D-15 f96 r%47 D3 f96 r%47

E C96 l8 @0 *4 D4 M4,1,-2,4 o3a+%42 *5 a+96 r%47 v0 D-4 >c96 r%47 D5 c96 r%47

F C96 l8 @0 *1

G C96 l8 t170 r%49 t142 r%54 t192 r%92

H C96 l8 vm2 r96 @45 v104 p1 D0 M96,1,134,255 o4a+%97& MF0 a+%95

I C96 l8 vm2 r96 @2 v110 p3 D0 M17,1,1,7 o2f+2. MF0 f+16 a+16 >c16 <d+16
