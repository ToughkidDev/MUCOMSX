#mucom88 1.7
#title BGM $8A
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#pcm SHINOB8A.BIN
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{D4924 o1b16 b%13 @2 D5156 b96}
#*2{D-3 M20,1,2,6}
#*3{D-3 M20,1,1,6}
#*4{o5b16 D1 M19,3,2,3 >a3& a& a r8.}

A C96 l2 vm2 @60 v111 D0 M29,2,2,2 p3 o3f& f& f& f& f& f& f& f& f& f8.

B C96 l2 vm2 @60 v111 D2 M38,3,2,2 p1 o4e& e& e& e& e& e& e& e& e& e8.

C C96 l2 vm2 @60 v111 D-3 M38,2,4,2 p2 o4b& b& b& b& b& b& b& b& b& b8.

G C96 l2 t179 r%156 t178 r%67 t179 r%253

H C96 l2 vm2 r%84 @21 v99 D2 M20,1,1,6 p3 o5e32 f32 a32 *2 b32& b& b4 r8. D0
H M20,1,1,6 >c16 *2 <b& b8 r8 D0 M20,1,1,6 >c16 *2 <b8.& b4 D1 M20,1,1,6 a16 *2
H *4

I C96 l2 vm2 r%90 @21 v97 D2 M19,2,1,3 p2 o5e32 f32 a32 *3 b32& b& b4 r8. D0
I M19,2,1,3 >c16 *3 <b& b8 r8 D0 M19,2,1,3 >c16 *3 <b8.& b4 D1 M19,2,1,3 a16 *3
I *4

K C96 l2 p3 r%90 @1 v62 *1 r%82 @1 D4924 b%13 @2 D5156 b96 r%112 @1 *1 r%22 [
K @1 *1 r24 ]2 @1 D4924 b16 b8 b16 b8
