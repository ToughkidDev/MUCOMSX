#mucom88 1.7
#title BGM $92
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{o6g24 d+24 M4,2,4,2 d24 M5,1,2,4 c& c8}
#*2{o6g16 M18,1,3,4 a& a4& a4}
#*3{r8 @80 v107 D0 M11,1,3,4}

A C96 l2 vm2 r8 @79 v114 D0 M11,1,3,4 p3 o3d+& d+4. M10,1,3,4 d& d r96

B C96 l2 vm2 @21 v101 D0 M5,1,2,4 p3 *1 M3,2,4,2 d+16 M4,1,2,4 d16 c16 M3,2,4,2
B *2

C C96 l2 vm2 *3 p1 o4d& d4. M10,1,3,4 c& c

G C96 l2 t179 r2. t145 r4 t170 r%41 t171 r%31 t195 r%30

H C96 l2 vm2 *3 p2 o4g& g4. M10,1,3,4 a& a

I C96 l2 vm2 r16 @21 v99 D0 M5,1,2,4 p2 *1 M4,1,2,4 d+16 d16 M3,2,4,2 c16
I M5,1,2,4 *2
