#mucom88 1.7
#title BGM $98
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#pcm SHINOB98.BIN
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{r%7 E255,255,0,255,1,255 v6 o8g+%11 r%7 E255,255,0,255,0,255}
#*2{@106 v109 D0 MF0}
#*3{D-24 M3,1,1657,5 o8g+%11 r%7 v10 g+%11 r%7}
#*4{P1 E255,255,0,255,1,255}

A C96 l16 vm2 @105 v111 D0 M24,2,5,4 p3 o3g g r8 g f g g+8. a+%60

B C96 l16 vm2 *2 p3 o6f f r8 f8. d8. M24,1,3,5 d+%60

C C96 l16 vm2 *2 p2 o6d d r8 d8. c8. M24,1,3,5 c%60

D C96 l16 @0 r%60 *4 v12 *3 v9 g+%11 r%7 E255,255,0,255,2,255 v8 g+%11 *1 v5
D g+16. r16.

E C96 l16 @0 r%63 *4 v11 *3 v8 g+%10 r12 E255,255,0,255,2,255 v7 g+%11 *1 v0
E g+96 r%17

G C96 l16 t191 r%171

H C96 l16 vm2 *2 p1 o6c c r8 c8. <a+8. M24,1,3,5 >g+%60

I C96 l16 vm2 *2 p3 o5g g r8 g8. a+8. M24,1,3,5 f%60

K C96 l16 p3 @2 v62 D-801 o1a+ D869 a+8. @1 D5037 b8. b8. @2 D484 a+%30 r8.
