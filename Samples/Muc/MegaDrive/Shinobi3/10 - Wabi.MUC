#mucom88 1.7
#title BGM $8C
#composer Sega
#author ToughkidCST
#comment Shinobi III: Return of the Ninja Master (U)
#driver mucomDotNET
#voice SHINOBI3.DAT
#CarrierCorrection Yes
; A B C H I J = YM2612 FM1-6, D E F = SN76489 tone 1-3 (noise on F), K = DAC
; G = tempo only (t follows the driver tick times)

; macros (#*n{...} is pasted where *n stands)
#*1{o6a+ >c d+ f M1,1,-2,2 d+ M2,1,-2,2 c}
#*2{r48 P1 E255,255,0,255,2,255 v11}

A C96 l8 vm2 @64 v111 D0 M2,1,-2,2 p3 o6f *1 d+ f16 M2,1,-1,3 f4

B C96 l8 vm2 r16 @64 v109 D0 M2,1,-2,2 p1 o6f *1 d+ M2,1,-1,3 f16 f4

C C96 l8 vm2 @45 v104 D0 M3,2,1,3 p2 o4f2& f2& f2& f2

D C96 l8 @0 *2 D3 M4,1,-9,4 o4f%42 r%150

E C96 l8 @0 *2 D4 M4,1,-2,4 o3a+%42 r%150

G C96 l8 t169 r2 t143 r%54 t191 r%55 t192 r%37

H C96 l8 vm2 @45 v104 D0 M3,2,3,2 p1 o4a+2& a+2& M0,1,134,255 a+96& MF0
H a+%47& a+2

I C96 l8 vm2 @2 v110 D0 M18,1,1,7 p3 o2f+2& f+4 M14,1,2,5 f+16 M14,2,3,3 a+16
I M16,2,3,3 >c16 M19,1,1,7 <d+16 M21,1,1,8 f2& f2
