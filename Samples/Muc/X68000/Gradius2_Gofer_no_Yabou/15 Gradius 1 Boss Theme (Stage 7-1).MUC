#mucom88 1.7
#title Gradius II Gradius 1 Boss Theme (Stage 7-1)
#composer Konami Kukeiha Club
#author ToughkidCST
#comment Gradius II -Gofer no Yabou- (X68000)
#voice GRADIUS2.DAT
#pcm GRADIUS2.BIN
#CarrierCorrection Yes
; Requires current MucoMSX MSX PSG/SCC extensions (msPb0102).
; YM2151 FM -> OPNA FM: A=ch1 B=ch2 C=ch3 H=ch4 I=ch5 J=ch6
; YM2151 FM -> SCC wave+envelope: SCCA=ch7
; K = MSM6258 ADPCM -> ADPCM-B (GRADIUS2.BIN)
; F = tempo only: Timer-B values alternate so 1 clock = 2 driver ticks

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ 0,78,119,127,111,92,74,38,0,-19,-6,37,68,67,46,17,0,-17,-46,-67,-68,-38,5,19,0,-38,-74,-93,-111,-127,-119,-78 }
