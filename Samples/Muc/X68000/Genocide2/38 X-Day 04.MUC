#mucom88 1.7
#title Genocide 2 X-Day 04
#composer Hideyuki Shimono, Naoyuki Kimura
#author ToughkidCST
#comment Genocide 2 (X68000)
#voice GENOCID2.DAT
#CarrierCorrection Yes
; Requires current MucoMSX MSX PSG/SCC extensions (msPb0102).
; YM2151 FM -> OPNA FM: A=ch1 B=ch4 C=ch5 H=ch6 I=ch7 J=ch8
; YM2151 FM -> SCC wave+envelope: SCCA=ch2 SCCB=ch3
; F = tempo only: Timer-B values alternate so 1 clock = 1 driver tick

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ 0,83,96,92,94,106,116,121,121,119,127,88,29,25,30,21,0,-21,-30,-25,-29,-88,-127,-119,-121,-121,-116,-106,-94,-92,-96,-83 }

