#mucom88 1.7
#title Genocide 2 Opening 1
#composer Hideyuki Shimono, Naoyuki Kimura
#author ToughkidCST
#comment Genocide 2 (X68000)
#voice GENOCID2.DAT
#CarrierCorrection Yes
; Requires current MucoMSX MSX PSG/SCC extensions (msPb0102).
; YM2151 FM -> OPNA FM: A=ch1 B=ch2 C=ch3 H=ch4 I=ch5 J=ch6
; YM2151 FM -> SCC wave+envelope: SCCA=ch7 SCCB=ch8
; F = tempo only: Timer-B values alternate so 1 clock = 1 driver tick

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ -1,46,90,116,125,118,88,48,2,-49,-89,-115,-127,-117,-88,-50,0,49,87,116,127,115,90,49,-1,-47,-88,-118,-125,-117,-91,-47 }
  @W1:{ 0,90,127,90,0,-90,-127,-90,0,90,127,90,0,-90,-127,-90,0,90,127,90,0,-90,-127,-90,0,90,127,90,0,-90,-127,-90 }

; macros (#*n{...} is pasted where *n stands)
#*1{o3c24& D35 c24& D73 c24& D-2}
#*2{o3d+4 c+ d+}
#*3{D-3 o2d4. D-4 b24& D65 b24& D-2 >c+24& D-3 d4 D-2}
