#mucom88 1.7
#title Genocide 2 Game Over
#composer Hideyuki Shimono, Naoyuki Kimura
#author ToughkidCST
#comment Genocide 2 (X68000)
#voice GENOCID2.DAT
#pcm GENOCID2.BIN
#CarrierCorrection Yes
; Requires current MucoMSX MSX PSG/SCC extensions (msPb0102).
; YM2151 FM -> OPNA FM: A=ch1 B=ch2 C=ch3 H=ch6 I=ch7 J=ch8
; YM2151 FM -> SCC wave+envelope: SCCA=ch4 SCCB=ch5
; K = MSM6258 ADPCM -> ADPCM-B (GENOCID2.BIN)
; F = tempo only: Timer-B values alternate so 1 clock = 2 driver ticks

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ -4,127,71,90,87,12,-39,49,4,-49,39,-13,-87,-89,-70,-127,-4,127,71,90,87,12,-39,49,4,-49,39,-13,-87,-89,-70,-127 }

