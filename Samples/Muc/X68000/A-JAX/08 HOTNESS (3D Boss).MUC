#mucom88 1.7
#title A-JAX HOTNESS (3D Boss)
#composer Konami Kukeiha Club
#author ToughkidCST
#comment A-JAX (X68000)
#voice AJAX.DAT
#pcm AJAX08.BIN
#CarrierCorrection Yes
; YM2151 FM -> OPNA FM: A=MIDI1 B=MIDI2 C=MIDI3 H=MIDI4 I=MIDI5 J=MIDI6
; K = MSM6258 ADPCM -> ADPCM-B (AJAX08.BIN)
; G = MSM6258 bass kick -> YM2608 rhythm channel (bass drum)
; F = tempo only: Timer-B values alternate so 1 clock = 1 driver tick

; macros (#*n{...} is pasted where *n stands)
#*1{H0,0,0 q22 o6e5. MF0 q2 e30}
#*2{M10,2,2,8 q22 o6f5. MF0 q2 f30 e30 f30 M10,8,9,2}
#*3{o6g30 M10,4,5,4 q7 a+10 a10 M10,1,1,17 g10 M10,2,2,8}
#*4{o6d <a+ f}
#*5{o6c D4 <g}
#*6{o6d D4 <a+ D3 f}
#*7{o4c20 >c20 <c20 q2 >c q6 <c20 q2 c q4 >c20}
#*8{o4c20 >c20 <d+20 >d+20 <d20 >d20 <c+20 >c+20}

A C240 l40 vm2 r5 L M10,8,7,2 @31 v110 p3 *1 d30 e30 *2 q22 g5. MF0 q2 g30 f30
A *3 f10

