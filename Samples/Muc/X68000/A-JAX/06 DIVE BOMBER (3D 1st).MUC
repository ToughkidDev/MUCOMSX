#mucom88 1.7
#title A-JAX DIVE BOMBER (3D 1st)
#composer Konami Kukeiha Club
#author ToughkidCST
#comment A-JAX (X68000)
#voice AJAX.DAT
#pcm AJAX05.BIN
#CarrierCorrection Yes
; Needs MucoMSX v1.5-Stable+ (MucoMSXExtension SCC parts, msPb0102).
; YM2151 FM -> OPNA FM: A=MIDI1 B=MIDI2 C=MIDI3 H=MIDI4 I=MIDI5 J=MIDI6
; SCCA = MSM6258 loop held on after the K note (SCC unison)
; K = MSM6258 ADPCM -> ADPCM-B (AJAX05.BIN)
; F = tempo only: Timer-B values alternate so 1 clock = 1 driver tick

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ 51,50,0,16,4,31,44,-65,-98,-85,-79,22,45,16,23,11,49,23,-15,40,30,46,25,-53,-46,-127,-75,-41,32,50,10,66 }

