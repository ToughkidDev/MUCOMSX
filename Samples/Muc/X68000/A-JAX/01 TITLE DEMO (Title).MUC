#mucom88 1.7
#title A-JAX TITLE DEMO (Title)
#composer Konami Kukeiha Club
#author ToughkidCST
#comment A-JAX (X68000)
#voice AJAX.DAT
#pcm AJAX.BIN
#CarrierCorrection Yes
; Needs MucoMSX v1.5-Stable+ (MucoMSXExtension SCC parts, msPb0102).
; YM2151 FM -> OPNA FM: A=MIDI1 B=MIDI1b C=MIDI2 H=MIDI2b I=MIDI3 J=MIDI4
; YM2151 FM -> SCC wave+envelope: SCCA=MIDI5 SCCB=MIDI6
; SCCC = MSM6258 loop held on after the K note (SCC unison)
; K = MSM6258 ADPCM -> ADPCM-B (AJAX.BIN)
; F = tempo only: Timer-B values alternate so 1 clock = 1 driver tick

; SCC waves: steady-state shape of the YM2151 voices
  @W0:{ 0,117,-19,82,26,32,114,110,87,46,127,70,95,111,-55,23,0,-23,55,-111,-95,-70,-127,-46,-87,-110,-114,-32,-26,-82,19,-117 }
  @W1:{ 0,82,35,86,55,61,125,121,114,99,127,102,108,93,-18,17,0,-17,18,-93,-108,-102,-127,-99,-114,-121,-125,-61,-55,-86,-35,-82 }
  @W2:{ 51,50,0,16,4,31,44,-65,-98,-85,-79,22,45,16,23,11,49,23,-15,40,30,46,25,-53,-46,-127,-75,-41,32,50,10,66 }

; macros (#*n{...} is pasted where *n stands)
#*1{q4 o5a8 >g8 g8 >f8 q13 <g4. q2 g g}
#*2{q4 o7d8 d8 >c8 c8 q0 c1& c%60}
#*3{q4 o6d8 d8 >c8 c8 q13 c4. q2 <e >c}

A C96 l16 vm2 @37 v109 p2 q1 o5a+32 D1 b32 D0 q13 g4. q2 g g *1 *2

B C96 l16 vm2 r @37 v109 p2 q13 o6c4. q2 <e >c *3 q4 <a8 >g8 g8 >f8 q0
B <e1& e%60

C C96 l16 vm2 r32 @37 v109 p1 D3 q1 o5a+32 b32 D1 q13 >c4. q2 <e >c D2 *1 D1 *2

F C96 l16 [ t173 r96 t172 r24 ]71 t173 r48

H C96 l16 vm2 r16. @37 v109 p1 D2 q13 o5g4. q2 g g D1 *3 D2 q4 <a8 >g8 g8 >f8
H D1 q0 e1& e%60

I C96 l16 vm2 @10 v116 p3 D3 q1 o3a+32 b32 D2 q36 >c1 q0 c1& c1& c%60

J C96 l16 vm2 @6 v113 p3 q1 o3a+32 b32 q36 >c1 q0 c1& c1& c%60

K C96 l16 r%7 @15 D31695 p3 v240 o1c%26 r%69 c%26 r%70 c%26 r1 r%37

SCCA C96 l16 r1 r1 r @0 E255,255,0,255,2,6 v5 D-5 q2 o3g [ D-8 >c d D-5 g ]2
SCCA D-8 >c D-5 <g D-8 >c D0 d D-13 q0 g%90

SCCB C96 l16 r1 r1 r%15 @1 E255,255,0,255,2,6 v5 q2 o3g [ D1 >c D0 d D-5 g ]2
SCCB D0 >c D-5 <g D0 >c d q0 g%81

SCCC C96 l16 r%33 @2 E255,255,0,255,0,255 v9 D79 q26 o2c%95 c1 q0 c1& c%37
