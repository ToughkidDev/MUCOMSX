; ---- FM voices / FM音色 ----
; [EN] @n / FB,ALG / one line per operator OP1-OP4
;      (AR,D1R,D2R,RR,D1L,TL,KS,ML,DT).
; [JA] @n / FB,ALG / オペレータOP1-OP4ごとに1行
;      (AR,D1R,D2R,RR,D1L,TL,KS,ML,DT)。
; @1 lead: ALG 4, a bright pair and an x3 pair detuned against it
;    リード: ALG 4、明るい組と、デチューンした3倍の組
  @1
   6,4
   31,6,2,6,3,28,0,1,3
   31,4,1,6,2,0,0,1,3
   31,8,2,6,3,34,0,3,7
   31,4,1,6,2,0,0,1,7

; @2 bass: ALG 0, the first operators decay fast for the attack
;    ベース: ALG 0、前段のオペレータが速く減衰してアタックを作る
  @2
   5,0
   31,18,0,8,2,26,0,0,0
   31,14,0,8,2,38,0,1,3
   31,12,0,8,2,34,0,1,7
   31,8,4,8,2,0,0,1,0

; @3 brass: ALG 4, the modulators open slower than the carriers
;    ブラス: ALG 4、モジュレータがキャリアより遅く開く
  @3
   5,4
   18,8,0,7,4,28,0,1,3
   22,4,1,7,1,0,0,1,3
   18,8,0,7,4,32,0,1,7
   22,4,1,7,1,0,0,1,7

; @4 strings: ALG 4, slow attack and release
;    ストリングス: ALG 4、ゆっくりしたアタックとリリース
  @4
   6,4
   14,2,0,5,1,34,0,1,3
   12,2,1,5,1,0,0,1,3
   14,2,0,5,1,38,0,2,7
   12,2,1,5,1,0,0,1,7

; @5 harmony: ALG 4, a softer lead that sits under @1
;    ハーモニー: ALG 4、@1の下に収まる柔らかいリード
  @5
   4,4
   31,8,2,6,3,36,0,1,3
   28,4,1,6,2,0,0,1,3
   31,10,3,6,4,40,0,2,7
   28,4,1,6,2,0,0,1,7

; ---- OPNA FM / OPNA FM ----
; [EN] A sets the tempo (t198 = the MSX parts' timer) for the song.
;      Every OPNA part starts with C96 and loops from the start (L).
; [JA] Aでテンポ(t198 = MSXパートのタイマー)を決めます。OPNAの
;      全パートはC96で始まり、先頭からループします(L)。
A t198 C96 L @1 v7 q1 p3 M18,1,2,5 D2
A   r1 | r1
A   o6 c2 f4 a4 | b8 r16 g16 g2.
A   r1 | r1
A   o6 c2 f4 a4 | b8 r16 g16 g2.
A   o5 a4 >e2 d12 c+12 <a12 | b4 >f+2.
A   o5 a4 >e2 d12 c+12 <a12 | b4 >b2.
A   o6 d4 a2. | f2 c4 f4
A   o6 e12 r12 <b12 >e2 a4 | g+1
A   o5 a4 >e2 d12 c+12 <a12 | b4 >f+2.
A   o5 a4 >e2 d12 c+12 <a12 | b4 >b2.
A   o6 d4 a2. | f2 c4 f4
A   o6 e12 r12 <b12 >e%56 a12 b12 | >e1
A   o5 a%80 a12 b12 | >c2 <a4 >c4
A   o5 b2 g2 | a4 g+4 f+4 g+4
A   o5 a%80 a12 b12 | >c2 <a4 >c4
A   o5 b1 | >e2 f+4 g+4

B C96 L @5 v5 q1 p3 M18,1,2,5
B   r1 | r1
B   r1 | r1
B   r1 | r1
B   o5 a2 a4 >f4 | g8 r16 <b16 b2.
B   r1 | r1
B   r1 | r1
B   r1 | r1
B   r1 | r1
B   o5 c+4 >c+2 <b12 a12 c+12 | g4 >d2.
B   o5 c+4 >c+2 <b12 a12 c+12 | g4 >g2.
B   o5 f+4 >f+2. | <a2 a4 a4
B   o5 g+12 r12 g+12 g+%56 >f12 g+12 | g+1
B   o5 c%80 c12 g12 | a2 f4 a4
B   o5 g2 <b2 | >e4 e4 e4 e4
B   o5 c%80 c12 g12 | a2 f4 a4
B   o5 g1 | g+2 >d4 e4

; [EN] C H I one note each of the chord: @4 strings hold the bar,
;      @3 brass hits on the shuffle (1, the last triplet of 2, 3, the
;      last triplet of 4).
; [JA] C H I 和音の1音ずつ: @4ストリングスは1小節伸ばし、@3ブラスは
;      シャッフルで刻む(1拍目、2拍目の3連の最後、3拍目、4拍目の
;      3連の最後)。
C C96 L q1 p2
C   @4 v5 o4 a1 | a1 | a1 | b1
C   o4 a1 | a1 | a1 | b1
C   o4 a1 | b1 | a1 | b1
C   o4 a1 | a1 | b1 | g+1
C   @3 v5 o4 a12 r3 a12 a12 r3 a12 | b12 r3 b12 b12 r3 b12 | a12 r3 a12 a12 r3 a12 | b12 r3 b12 b12 r3 b12
C   o4 a12 r3 a12 a12 r3 a12 | a12 r3 a12 a12 r3 a12 | b12 r3 b12 b12 r3 b12 | g+12 r3 g+12 g+12 r3 g+12
C   @4 v5 o4 a1 | a1 | b1 | b1
C   @3 v5 o5 c12 r3 c12 c12 r3 c12 | c12 r3 c12 c12 r3 c12 | <b12 r3 b12 b12 r3 b12 | b12 r3 b12 a12 r3 b12

H C96 L q1 p3
